# Copy to .env at the repo root (not inside gateway/) — app/config.py reads
# it from there. Every gateway setting is SCANNER_-prefixed; anything else
# (ANTHROPIC_API_KEY) is read directly by the Anthropic SDK, unprefixed.

# --- LLM council -------------------------------------------------------------
# Resolves via the standard Anthropic SDK credential chain: ANTHROPIC_API_KEY,
# ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile. Uncomment to override:
# ANTHROPIC_API_KEY=sk-ant-...
SCANNER_COUNCIL_ENABLED=true
SCANNER_COUNCIL_SPECIALIST_MODEL=claude-opus-5
SCANNER_COUNCIL_ADJUDICATOR_MODEL=claude-opus-5
SCANNER_COUNCIL_MIN_SCORE=15

# --- storage -----------------------------------------------------------------
# Default is a local SQLite file. For production, point at Postgres:
# SCANNER_DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/prompt_scanner
SCANNER_DATABASE_URL=sqlite+aiosqlite:///./scanner.db

# --- enforcement ---------------------------------------------------------
# Baseline shape lives in gateway/app/policy/policy.yaml — this just flips
# the global kill switch for a monitoring-only rollout phase.
SCANNER_SHADOW_MODE=false
SCANNER_STORE_RAW_PROMPTS=false

# --- api ---------------------------------------------------------------
SCANNER_REQUIRE_API_KEY=false
SCANNER_API_KEY=change-me
SCANNER_DASHBOARD_ORIGINS=["http://localhost:5173"]

# --- dashboard auth ------------------------------------------------------
# HTTP Basic Auth in front of /v1/dashboard, /v1/admin, and /v1/live. Unset
# password = disabled (local dev default). Set both for anything deployed.
SCANNER_DASHBOARD_USERNAME=admin
SCANNER_DASHBOARD_PASSWORD=

# --- alerting ------------------------------------------------------------
# Any webhook endpoint (Slack incoming webhook, SIEM ingest, etc).
SCANNER_WEBHOOK_URL=
SCANNER_WEBHOOK_MIN_SEVERITY=high
